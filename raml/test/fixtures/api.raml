#%RAML 1.0
title: cfmartin-syteline-salesforce-prc-api

protocols: [HTTP,HTTPS]

/sync/{object}:
  description: Upserts syteline object records dynamically into the salesforce
  uriParameters:
    object:
      enum:
        - itemMaster
        - contactMaster
        - customerPartyMaster
        - salesOrder
        - orderLine
        - shipment
        - shipmentLines
        - shipTos
        - units
        - invoices
        - invoiceLines
        - pricebookEntry
      required: true
  post:
    body:
      application/json: 
        examples: 
          input: !include examples/sync-object-request.json
    responses:
      200:
        body:
          application/json:
            example: !include examples/sync-object-response.json
  delete:
    headers:
      Id:
        required: true 
        type: string
        example: "0031P00001Ax7LtQAJ"      
    responses:
      200:
        body:
          application/json:
            example:  !include examples/sync-object-response.json  
