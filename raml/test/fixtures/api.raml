#%RAML 1.0
title: library-catalog-sync-api

protocols: [HTTP,HTTPS]

/sync/{collection}:
  description: Upserts catalog records dynamically into the circulation system
  uriParameters:
    collection:
      enum:
        - titles
        - patrons
        - households
        - loans
        - loanItems
        - holds
        - holdItems
        - pickupDesks
        - formats
        - fines
        - fineLines
        - replacementCosts
      required: true
  post:
    body:
      application/json:
        examples:
          input: !include examples/sync-collection-request.json
    responses:
      200:
        body:
          application/json:
            example: !include examples/sync-collection-response.json
  delete:
    headers:
      Id:
        required: true
        type: string
        example: "PTR-000184-A7"
    responses:
      200:
        body:
          application/json:
            example:  !include examples/sync-collection-response.json
