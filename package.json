{
  "name": "tree-sitter-mulesoft",
  "version": "0.1.2",
  "description": "Tree-sitter grammars for MuleSoft DataWeave and RAML",
  "private": true,
  "workspaces": [
    "dataweave",
    "raml"
  ],
  "scripts": {
    "build": "npm run build:dw && npm run build:raml",
    "build:dw": "cd dataweave && tree-sitter generate",
    "build:raml": "cd raml && tree-sitter generate",
    "test": "npm run test:dw && npm run test:raml",
    "test:dw": "cd dataweave && tree-sitter test",
    "test:raml": "cd raml && tree-sitter test",
    "node-kinds": "node tools/generate-node-kinds.mjs dataweave && node tools/generate-node-kinds.mjs raml",
    "lint": "oxlint dataweave/grammar.js dataweave/bindings/node raml/grammar.js raml/bindings/node tools",
    "format": "oxfmt dataweave/grammar.js \"dataweave/bindings/node/*.js\" raml/grammar.js \"raml/bindings/node/*.js\" \"tools/*.mjs\"",
    "format:check": "oxfmt --check dataweave/grammar.js \"dataweave/bindings/node/*.js\" raml/grammar.js \"raml/bindings/node/*.js\" \"tools/*.mjs\""
  },
  "author": "M. Reifschneider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfpricot/tree-sitter-mulesoft.git"
  },
  "bugs": {
    "url": "https://github.com/alfpricot/tree-sitter-mulesoft/issues"
  },
  "homepage": "https://github.com/alfpricot/tree-sitter-mulesoft#readme",
  "devDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tree-sitter-cli": "0.27.2"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true,
    "tree-sitter@0.25.1": true
  },
  "type": "module"
}
